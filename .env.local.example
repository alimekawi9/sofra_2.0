NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Optional. Public site origin used to build absolute URLs (e.g. og:image)
# in server contexts without window.location. Falls back to Vercel's
# VERCEL_PROJECT_PRODUCTION_URL/VERCEL_URL, then http://localhost:3000.
NEXT_PUBLIC_SITE_URL=https://your-deployed-domain.com

# Server-only. Never prefix with NEXT_PUBLIC_ — must not reach the browser.
GEMINI_API_KEY=your-gemini-api-key-here

# Server-only Spotify Web API credentials. Create an app at
# https://developer.spotify.com/dashboard and never prefix these with NEXT_PUBLIC_.
SPOTIFY_CLIENT_ID=your-spotify-client-id
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret

# Server-only OAuth/export secrets. The service-role key is required because
# Spotify refresh tokens live in an RLS-protected table with no browser policy.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Generate once with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SPOTIFY_TOKEN_ENCRYPTION_KEY=your-base64-encoded-32-byte-key
